MONGODB_URI=mongodb://localhost:27017/basketball
# Generate with: openssl rand -base64 32 (NEXTAUTH_SECRET is also accepted)
AUTH_SECRET=your-auth-secret-here
NEXTAUTH_URL=http://localhost:3000
# Time zone for practice schedules and server-formatted times
ACADEMY_TIME_ZONE=Asia/Tbilisi
# Where uploaded photos are stored (default: ./uploads)
UPLOAD_DIR=./uploads

# Email (optional). Without it, "forgot password" requests go to an admin.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# EMAIL_FROM="Brooklyn Basketball Academy <no-reply@bba.ge>"
# EMAIL_TRANSPORT=console   # development: print emails to the server log
# Public URL used in emailed links (falls back to AUTH_URL / NEXTAUTH_URL)
# APP_URL=https://academy.example.com
